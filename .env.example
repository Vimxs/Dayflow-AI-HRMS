# =============================================================
# Dayflow HRMS — Environment Variables (EXAMPLE)
# Copy this file to .env and fill in your actual values.
# NEVER commit .env — only .env.example is committed.
# =============================================================

# ── Database ─────────────────────────────────────────────────
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/dayflow_dev?schema=public"

# ── JWT Secrets ───────────────────────────────────────────────
# Access token secret — generate with: openssl rand -hex 64
JWT_SECRET="REPLACE_WITH_STRONG_RANDOM_SECRET"
# Refresh token secret — use a DIFFERENT secret from JWT_SECRET
JWT_REFRESH_SECRET="REPLACE_WITH_A_DIFFERENT_STRONG_RANDOM_SECRET"

# JWT expiry (these are used by the auth lib — match Security doc §1)
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ── Email Provider ────────────────────────────────────────────
# STUB in dev (Phase 0–6): email sending uses console.log — see lib/email/
# Wire real provider in T7.1.
# Option A: Resend (recommended)
RESEND_API_KEY="re_REPLACE_WITH_YOUR_RESEND_API_KEY"
EMAIL_FROM="Dayflow HRMS <noreply@yourdomain.com>"
# Option B: SMTP (Nodemailer)
# SMTP_HOST="smtp.yourprovider.com"
# SMTP_PORT="587"
# SMTP_USER="your@email.com"
# SMTP_PASS="your-smtp-password"

# ── File Storage (S3-compatible) ──────────────────────────────
# STUB in dev (Phase 0–3): file uploads use local /tmp stub — see lib/storage/
# Wire real S3 in T3.4.
S3_BUCKET="dayflow-documents"
S3_REGION="ap-south-1"
S3_ACCESS_KEY="REPLACE_WITH_YOUR_S3_ACCESS_KEY"
S3_SECRET_KEY="REPLACE_WITH_YOUR_S3_SECRET_KEY"
S3_ENDPOINT=""  # Leave empty for AWS S3; set for MinIO/Cloudflare R2

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Misc ──────────────────────────────────────────────────────
NODE_ENV="development"
