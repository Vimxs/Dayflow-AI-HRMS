# =================================================================
# Dayflow HRMS — Environment Variables Template
# Copy this file to .env and replace placeholder values for local development.
# NEVER COMMIT REAL SECRETS IN VERSION CONTROL.
# =================================================================

# Database Connection (PostgreSQL via Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/dayflow_db?schema=public"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# JWT Authentication Secrets
JWT_ACCESS_SECRET="your-super-secret-access-token-key-change-in-production-min-32-chars"
JWT_REFRESH_SECRET="your-super-secret-refresh-token-key-change-in-production-min-32-chars"

# Email Provider Configuration (SMTP / Resend / Nodemailer)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT="2525"
SMTP_USER="placeholder_smtp_user"
SMTP_PASS="placeholder_smtp_password"
SMTP_FROM="Dayflow HRMS <no-reply@dayflow.internal>"

# File Storage Configuration (S3 / R2 / MinIO / Local storage fallback)
S3_BUCKET="dayflow-documents-placeholder"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="placeholder_s3_key_id"
S3_SECRET_ACCESS_KEY="placeholder_s3_secret_key"
S3_ENDPOINT=""

# Rate Limiting & Security (Optional override for development)
NODE_ENV="development"
