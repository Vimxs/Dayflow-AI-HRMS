# ===========================
# Dayflow HRMS — .gitignore
# ===========================

# Secrets — NEVER commit
.env
.env.local
.env.*.local

# Dependencies
node_modules/

# Next.js build output
.next/
out/
dist/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS artifacts
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# TypeScript build info
*.tsbuildinfo
next-env.d.ts

# Prisma generated
# (keep schema.prisma committed; generated client is in node_modules)

# Test coverage
coverage/

# ===========================
# NOT ignored (explicitly tracked):
#   /docs/          ← planning docs + memory.md
#   .env.example    ← committed with placeholder values only
# ===========================
